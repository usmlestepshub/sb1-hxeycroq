<section class="py-16 bg-accent-50">
  <div class="container-custom">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="p-8 md:p-12 lg:p-16">
          <div class="animate-on-scroll">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Crush Your Medical Exams?</h2>
            <p class="text-lg text-gray-600 mb-8">
              Join over 10,000 medical students who have used MedRecalls to pass their exams with confidence. Start preparing smarter today.
            </p>
            
            <div class="flex flex-wrap gap-4">
              <a href="https://gumroad.com" class="btn-accent">
                Get Premium Recalls
              </a>
              <a href="/blog" class="btn-outline">
                Explore Free Resources
              </a>
            </div>
            
            <div class="mt-8 flex items-center">
              <div class="flex -space-x-2 mr-4">
                <img class="w-10 h-10 rounded-full border-2 border-white" src="https://images.pexels.com/photos/614810/pexels-photo-614810.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="User" />
                <img class="w-10 h-10 rounded-full border-2 border-white" src="https://images.pexels.com/photos/762020/pexels-photo-762020.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="User" />
                <img class="w-10 h-10 rounded-full border-2 border-white" src="https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="User" />
              </div>
              <span class="text-sm text-gray-600">Joined by 10,000+ medical students</span>
            </div>
          </div>
        </div>
        
