---
const navLinks = [
  { text: "Home", href: "/" },
  { text: "Blog", href: "/blog" },
  { 
    text: "Exam Resources", 
    href: "#",
    children: [
      { text: "USMLE Step 1", href: "/exams/usmle-step-1" },
      { text: "USMLE Step 2 CK", href: "/exams/usmle-step-2-ck" },
      { text: "USMLE Step 3", href: "/exams/usmle-step-3" },
      { text: "Clinical Shelf Exams", href: "/exams/shelf-exams" },
    ]
  },
  { text: "About", href: "/about" },
  { text: "Contact", href: "/contact" },
];
---

<header 
  x-data="{ isOpen: false, isScrolled: false }" 
  @scroll.window="isScrolled = window.pageYOffset > 50"
  :class="{ 'header-scroll': isScrolled }"
  class="fixed w-full top-0 z-50 transition-all duration-300"
>
  <div class="container-custom">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center">
          <span class="text-2xl font-bold text-primary-600">MedRecalls</span>
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:ml-10 md:flex md:items-center md:space-x-8">
        {navLinks.map((link) => 
          !link.children ? (
            <a href={link.href} class="text-base font-medium text-gray-700 hover:text-primary-600 transition-colors">
              {link.text}
            </a>
          ) : (
            <div x-data="{ open: false }" class="relative">
              <button 
                @click="open = !open" 
                @click.away="open = false"
                class="flex items-center text-base font-medium text-gray-700 hover:text-primary-600 transition-colors focus:outline-none"
              >
                {link.text}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              <div 
                x-show="open" 
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 translate-y-1"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 translate-y-0"
                x-transition:leave-end="opacity-0 translate-y-1"
                class="absolute left-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10"
                style="display: none;"
              >
                <div class="py-1">
                  {link.children.map((child) => (
                    <a 
                      href={child.href} 
                      class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-primary-600"
                    >
                      {child.text}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )
        )}
      </nav>
      
      <!-- CTA Button -->
      <div class="hidden md:flex">
        <a href="https://gumroad.com" class="btn-accent">Get Premium Recalls</a>
      </div>
      
      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button 
          @click="isOpen = !isOpen" 
          type="button" 
          class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-primary-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Icon when menu is closed -->
          <svg 
            x-show="!isOpen" 
            xmlns="http://www.w3.org/2000/svg" 
            class="h-6 w-6" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Icon when menu is open -->
          <svg 
            x-show="isOpen" 
            xmlns="http://www.w3.org/2000/svg" 
            class="h-6 w-6" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
            style="display: none;"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile menu -->
  <div 
    x-show="isOpen" 
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 transform scale-100"
    x-transition:leave-end="opacity-0 transform scale-95"
    class="md:hidden bg-white shadow-lg"
    style="display: none;"
  >
    <div class="pt-2 pb-4 space-y-1 px-4">
      {navLinks.map((link) => 
        !link.children ? (
          <a 
            href={link.href} 
            class="block py-2 px-3 text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 rounded-md"
          >
            {link.text}
          </a>
        ) : (
          <div x-data="{ open: false }">
            <button 
              @click="open = !open" 
              class="flex justify-between items-center w-full py-2 px-3 text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 rounded-md"
            >
              <span>{link.text}</span>
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                :class="{'rotate-180': open}" 
                class="h-4 w-4 transition-transform duration-200" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div x-show="open" style="display: none;">
              <div class="pl-4 space-y-1">
                {link.children.map((child) => (
                  <a 
                    href={child.href} 
                    class="block py-2 px-3 text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 rounded-md"
                  >
                    {child.text}
                  </a>
                ))}
              </div>
            </div>
          </div>
        )
      )}
      <div class="pt-4">
        <a href="https://gumroad.com" class="block w-full text-center btn-accent">
          Get Premium Recalls
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-20"></div>

<script>
  // Intersection Observer for scroll animations
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1 });
    
    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  });
</script>