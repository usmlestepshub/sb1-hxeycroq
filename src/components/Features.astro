---

<section class="section bg-gray-50">
  <div class="container-custom">
    <div class="section-title">
      <h2>Why Students Choose MedRecalls</h2>
      <p>Our comprehensive resources are trusted by thousands of medical students worldwide to help them pass their exams on the first try.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {features.map((feature, index) => (
        <div class="card p-6 animate-on-scroll" style={`animation-delay: ${index * 0.1}s;`}>
          <div class="bg-primary-100 p-3 rounded-lg inline-block mb-4">
            <div class="text-primary-600" set:html={feature.icon} />
          </div>
          <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
          <p class="text-gray-600">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>