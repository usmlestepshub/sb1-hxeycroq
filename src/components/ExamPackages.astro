---
const examPackages = [
  {
    title: "USMLE Step 1",
    description: "Complete preparation package with high-yield recalls, practice questions, and detailed explanations.",
    features: ["2,500+ Exam Recall Questions", "90% Match Rate with Recent Exams", "Comprehensive Explanations", "Weekly Updates"],
    price: "$149",
    popular: true,
    link: "https://gumroad.com"
  },
  {
    title: "USMLE Step 2 CK",
    description: "Master clinical knowledge with our comprehensive Step 2 CK package focusing on patient management.",
    features: ["3,000+ Clinical Vignettes", "High-Yield Clinical Algorithms", "Patient Management Strategies", "Weekly Updates"],
    price: "$169",
    popular: false,
    link: "https://gumroad.com"
  },
  {
    title: "Clinical Shelf Exams",
    description: "Specialized packages for each core rotation to help you excel in your clinical shelf examinations.",
    features: ["Rotation-Specific Content", "NBME-Style Questions", "Clinical Pearls & Tips", "Bi-weekly Updates"],
    price: "$99",
    popular: false,
    link: "https://gumroad.com"
  }
];
---

<section class="section bg-gradient-to-b from-primary-50 to-white">
  <div class="container-custom">
    <div class="section-title">
      <h2>Premium Exam Preparation Packages</h2>
      <p>Choose the package that best fits your exam preparation needs and start studying with confidence.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      {examPackages.map((pkg, index) => (
        <div class={`card relative overflow-hidden border-2 ${pkg.popular ? 'border-primary-600' : 'border-gray-200'} animate-on-scroll`} style={`animation-delay: ${index * 0.1}s;`}>
          {pkg.popular && (
            <div class="absolute top-0 right-0 bg-primary-600 text-white px-4 py-1 text-sm font-semibold">
              Most Popular
            </div>
          )}
          
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2">{pkg.title}</h3>
            <p class="text-gray-600 mb-4">{pkg.description}</p>
            
            <div class="text-3xl font-bold text-primary-600 mb-6">
              {pkg.price}
            </div>
            
            <ul class="space-y-3 mb-8">
              {pkg.features.map(feature => (
                <li class="flex items-start">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 mt-0.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            
            <a 
              href={pkg.link}
              class={`block w-full text-center py-3 rounded-lg font-medium ${pkg.popular ? 'bg-primary-600 text-white hover:bg-primary-700' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'} transition-colors`}
            >
              Get Access Now
            </a>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-12 p-6 bg-gray-100 rounded-xl">
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div>
          <h3 class="text-2xl font-bold mb-2">Need a Custom Package?</h3>
          <p class="text-gray-600">Contact us for discounted bundle pricing or specialized resources for your specific needs.</p>
        </div>
        <a href="/contact" class="btn-primary mt-4 md:mt-0">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>