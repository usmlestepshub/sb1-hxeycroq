<style>
.prose {
  @apply text-gray-800;
}

.prose h2 {
  @apply text-2xl font-bold mt-10 mb-4;
}

.prose h3 {
  @apply text-xl font-bold mt-8 mb-3;
}

.prose p {
  @apply mb-6;
}

.prose .lead {
  @apply text-xl text-gray-600 mb-8;
}

.prose ul {
  @apply mb-6 list-disc pl-6;
}

.prose li {
  @apply mb-2;
}

.prose a {
  @apply text-primary-600 hover:text-primary-700 font-medium;
}

.cta-box {
  @apply bg-primary-50 p-6 rounded-xl mt-10 mb-6;
}

.cta-box h3 {
  @apply text-xl font-bold mb-3;
}

.cta-box p {
  @apply mb-4;
}

.cta-box .btn-accent {
  @apply inline-flex items-center justify-center rounded-lg px-5 py-3 text-base font-medium transition-colors duration-200 bg-accent-500 text-white hover:bg-accent-600;
}
</style>