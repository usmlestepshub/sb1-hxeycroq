        </div>
        
        <div class="rounded-2xl overflow-hidden mb-8 animate-on-scroll" style="animation-delay: 0.2s;">
          <img src={image} alt={title} class="w-full h-auto aspect-video object-cover" />
        </div>
      </div>
      
      <!-- Content -->
      <div class="prose prose-lg max-w-none animate-on-scroll" style="animation-delay: 0.3s;" set:html={content} />
      
      <!-- Social Sharing -->
      <div class="border-t border-gray-200 mt-12 pt-8">
        <div class="flex flex-col sm:flex-row items-center justify-between">
          <div class="mb-4 sm:mb-0">
            <h3 class="text-lg font-semibold mb-2">Share this article</h3>
